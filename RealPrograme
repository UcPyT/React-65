--// Ball Control Script
local ball = nil
local speedMultiplier = 1000

local function adjustBallProperties()
    if not ball then return end

    ball.CanCollide = false
    ball.Massless = true

    local initialVelocity = character.HumanoidRootPart.CFrame.LookVector * 200000
    ball.Velocity = initialVelocity
    ball.AssemblyLinearVelocity = initialVelocity

    local bodyPosition = Instance.new("BodyPosition", ball)
    bodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyPosition.Position = character.HumanoidRootPart.Position + Vector3.new(0, -1.5, 1)
    bodyPosition.D = 1000000
    bodyPosition.P = math.huge

    local bodyGyro = Instance.new("BodyGyro", ball)
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.CFrame = character.HumanoidRootPart.CFrame
    bodyGyro.D = 1000000
    bodyGyro.P = math.huge

    ball.Touched:Connect(function(hit)
        if hit and hit.Parent and hit.Parent:IsA("Model") and hit.Parent ~= character then
            local boostedVelocity = character.HumanoidRootPart.CFrame.LookVector * 5000000
            ball.Velocity = boostedVelocity
            ball.AssemblyLinearVelocity = boostedVelocity
            ball.Position = character.HumanoidRootPart.Position + Vector3.new(0, -1.5, 1)
        end
    end)
end

local function findBall()
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Part") and obj.Name == "SoccerBall" then
            ball = obj
            adjustBallProperties()
            break
        end
    end
end

game:GetService("RunService").RenderStepped:Connect(function()
    if ball and character:FindFirstChild("HumanoidRootPart") then
        local direction = character.HumanoidRootPart.CFrame.LookVector
        ball.Velocity = direction * 200000 * speedMultiplier
        ball.AssemblyLinearVelocity = direction * 200000 * speedMultiplier
        ball.Position = character.HumanoidRootPart.Position + Vector3.new(0, -1.5, 1)
    end
end)

workspace.ChildAdded:Connect(function(child)
    if child:IsA("Part") and child.Name == "SoccerBall" then
        wait(0.1)
        findBall()
    end
end)

findBall()
